<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Forzar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Forzar www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Eliminar trailing slash excepto en raíz
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]
  
  # IMPORTANTE: Servir sitemap.xml y robots.txt directamente (NO rewrite)
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^\.well-known/ - [L]
  
  # Si el archivo o directorio existe, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Redirigir todo lo demás a index.html (para React Router)
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Compresión GZIP/Brotli para mejor rendimiento
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff
</IfModule>

# Brotli compression (si disponible)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# Cache para archivos estáticos (LCP optimization)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # Imágenes - cache largo
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Videos
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  
  # Fuentes
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  
  # CSS y JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # HTML - cache corto para actualizaciones
  ExpiresByType text/html "access plus 0 seconds"
  
  # XML y JSON
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
  # Recursos estáticos con hash - inmutables
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Imágenes
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Fuentes
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # HTML - no cache para SPA
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Cabeceras de seguridad completas
<IfModule mod_headers.c>
  # Content Security Policy (CSP) - XSS protection
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com https://www.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://maps.googleapis.com; frame-src 'self' https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self';"
  
  # HSTS - forzar HTTPS (1 año, preload ready)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Cross-Origin-Opener-Policy (COOP) - aislamiento de orígenes
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  
  # Cross-Origin-Embedder-Policy (COEP) - solo si no usas iframes externos
  # Header always set Cross-Origin-Embedder-Policy "require-corp"
  
  # Cross-Origin-Resource-Policy (CORP)
  Header always set Cross-Origin-Resource-Policy "same-site"
  
  # Prevenir MIME sniffing
  Header always set X-Content-Type-Options "nosniff"
  
  # Clickjacking protection
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # XSS Protection (legacy browsers)
  Header always set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy - balance entre SEO y privacidad
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Permissions Policy
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=()"
</IfModule>

# ETags optimization
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# Tipos MIME adicionales
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  # IMPORTANTE: Asegurar que XML se sirve con el tipo correcto
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# Forzar Content-Type correcto para sitemap y robots
<FilesMatch "sitemap\.xml$">
  Header set Content-Type "application/xml; charset=utf-8"
</FilesMatch>
<FilesMatch "robots\.txt$">
  Header set Content-Type "text/plain; charset=utf-8"
</FilesMatch>
